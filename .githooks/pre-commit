#!/bin/sh
set -eu

staged_swift_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')"

if [ -z "$staged_swift_files" ]; then
  exit 0
fi

file_count="$(printf '%s\n' "$staged_swift_files" | wc -l | tr -d ' ')"
echo "pre-commit: linting $file_count staged Swift files"

while IFS= read -r file; do
  [ -n "$file" ] || continue
  swift format lint --strict "$file"
done <<EOF
$staged_swift_files
EOF
